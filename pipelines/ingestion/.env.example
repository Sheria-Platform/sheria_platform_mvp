# =============================================================================
# SHERIA PLATFORM - INGESTION PIPELINE CONFIGURATION
# =============================================================================
# Copy this file to .env and update with your actual values
# All values below are examples and should be updated for your environment

# =============================================================================
# PIPELINE CONFIGURATION
# =============================================================================
ENABLE_GRAPH=false              # Set to 'true' to enable graph extraction (slow, optional)
MAX_WORKERS=2                   # Number of parallel workers for file processing (1-32); keep at 2 on CPU — LLM OLLAMA_NUM_PARALLEL=1 overflows above this
LOG_LEVEL=INFO                  # Logging level: DEBUG, INFO, WARNING, ERROR

# Chunking Configuration
CHUNK_SIZE=512                  # Token size for text chunks (50-8192)
CHUNK_OVERLAP=50                # Overlap between chunks (0 to CHUNK_SIZE-1)

# File Processing
MAX_FILE_SIZE_MB=100            # Maximum file size to process in MB

# =============================================================================
# OLLAMA CONFIGURATION (LLM & EMBEDDINGS)
# =============================================================================

# Ollama Endpoints (Remote Server)
OLLAMA_LLM_ENDPOINT=http://192.168.214.22:11435/api/chat
OLLAMA_GENERATE_ENDPOINT=http://192.168.214.22:11435/api/generate
OLLAMA_EMBED_ENDPOINT=http://192.168.214.22:11436/api/embeddings
OLLAMA_RERANK_ENDPOINT=http://192.168.214.22:11437/api/embeddings
OLLAMA_TAGS_ENDPOINT=http://192.168.214.22:11435/api/tags

# Ollama Model Names
OLLAMA_LLM_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=qwen3-embedding:4b

# =============================================================================
# EMBEDDING CONFIGURATION
# =============================================================================
EMBED_TIMEOUT=120               # Embedding API timeout in seconds (default: 120)
EMBED_MAX_RETRIES=3             # Maximum retry attempts for embeddings (default: 3)
EMBED_RETRY_DELAY=1             # Initial retry delay in seconds (exponential backoff)
EMBEDDING_BATCH_SIZE=10         # Number of chunks per embedding batch; 10 vs OLLAMA_NUM_PARALLEL=2 keeps queue shallow and avoids 504s

# =============================================================================
# LLM CONFIGURATION (For Graph Extraction)
# =============================================================================
LLM_TIMEOUT=180                 # LLM API timeout in seconds (default: 180)
LLM_MAX_RETRIES=3               # Maximum retry attempts for LLM (default: 3)
LLM_RETRY_DELAY=2               # Initial retry delay in seconds (exponential backoff)
LLM_TEMPERATURE=0.0             # Temperature for deterministic output (0.0-2.0)
LLM_MAX_TOKENS=1024             # Maximum tokens for LLM generation
GRAPH_BATCH_SIZE=10             # Number of chunks per graph extraction batch

# =============================================================================
# QDRANT CONFIGURATION (Vector Database)
# =============================================================================
QDRANT_HOST=192.168.214.21
QDRANT_PORT=6333
QDRANT_COLLECTION=kenya_law_reports

# CRITICAL: Must match your embedding model's dimension
# - qwen3-embedding:4b: 2560
# - nomic-embed-text: 768
# - mxbai-embed-large: 1024
# - all-minilm: 384
QDRANT_VECTOR_SIZE=2560         # Must match OLLAMA_EMBED_MODEL dimension

# Qdrant Reliability
QDRANT_TIMEOUT=60               # Qdrant request timeout in seconds
QDRANT_MAX_RETRIES=3            # Maximum retry attempts for Qdrant operations

# =============================================================================
# NEO4J CONFIGURATION (Graph Database)
# =============================================================================
NEO4J_URI=bolt://192.168.214.21:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Neo4j Reliability
NEO4J_TIMEOUT=30                # Neo4j connection timeout in seconds
NEO4J_MAX_RETRIES=3             # Maximum retry attempts for Neo4j operations

# =============================================================================
# MINIO CONFIGURATION (Object Storage)
# =============================================================================
MINIO_ENDPOINT=192.168.214.21:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false              # Set to 'true' for HTTPS

# =============================================================================
# RAY CONFIGURATION (Distributed Processing)
# =============================================================================
RAY_ADDRESS=auto                # Ray cluster address (auto for local)

# =============================================================================
# NOTES
# =============================================================================
# 1. QDRANT_VECTOR_SIZE must match your embedding model's output dimension
#    - Check with: ollama show <model_name>
#    - Or test: curl http://localhost:11434/api/embeddings \
#               -d '{"model": "your-model", "input": "test"}' | jq '.embeddings[0] | length'
#
# 2. For local development, use localhost instead of IP addresses
#
# 3. Increase timeouts and retries for unstable networks
#
# 4. Set ENABLE_GRAPH=false for faster ingestion (embeddings only)
#
# 5. Adjust MAX_WORKERS based on your CPU cores (recommend: number of cores)
#
# 6. For production, use stronger passwords and enable MINIO_SECURE=true
