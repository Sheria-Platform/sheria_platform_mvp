# =============================================================================
# deploy/local_dev/.env.example
# Sheria Platform — Ollama Dev Cluster Environment Variables
# =============================================================================
# Usage:
#   cp .env.example .env
#   # Edit .env as needed, then:
#   docker compose --profile cpu up -d    # CPU dev
#   docker compose --profile gpu up -d    # GPU cluster
# =============================================================================

# -----------------------------------------------------------------------------
# COMPOSE PROFILES
# Set to "cpu" for laptop/dev (no GPU) or "gpu" for workstation/staging.
# This controls which service variants start (GPU services have NVIDIA runtime
# requirements that will fail on machines without nvidia-container-toolkit).
# -----------------------------------------------------------------------------
COMPOSE_PROFILES=cpu

# -----------------------------------------------------------------------------
# MODEL ASSIGNMENTS
# CPU profile uses smaller models to fit in RAM.
# GPU profile uses full-size models for production-quality inference.
# -----------------------------------------------------------------------------

# LLM model — loaded on all 3 LLM nodes for round-robin load balancing
# GPU: qwen3:8b  |  CPU: qwen2.5:3b (fits in ~4GB RAM)
OLLAMA_LLM_MODELS=qwen2.5:3b

# Embedding model — legal text embeddings for Qdrant indexing
OLLAMA_EMBED_MODELS=nomic-embed-text

# Rerank model — relevance scoring for RAG retrieval
# GPU: Qwen3-Reranker-4B  |  CPU: qwen2.5:3b (shared with LLM)
OLLAMA_RERANK_MODELS=qwen2.5:3b

# -----------------------------------------------------------------------------
# HOST PORTS — LLM NODES (direct access, bypasses proxy)
# Use these to inspect individual nodes or for debugging.
# Normal API usage should go through the proxy ports below.
# -----------------------------------------------------------------------------
OLLAMA_LLM_EXT_PORT=11440     # ollama-llm  (node 1)
OLLAMA_LLM2_EXT_PORT=11443    # ollama-llm2 (node 2)
OLLAMA_LLM3_EXT_PORT=11444    # ollama-llm3 (node 3)
OLLAMA_EMBED_EXT_PORT=11441   # ollama-embed
OLLAMA_RERANK_EXT_PORT=11442  # ollama-rerank

# -----------------------------------------------------------------------------
# HOST PORTS — NGINX PROXY (use these from API / services / open-webui)
# -----------------------------------------------------------------------------
OLLAMA_PROXY_LLM_PORT=11433    # LLM endpoint  → round-robin across 3 nodes
OLLAMA_PROXY_EMBED_PORT=11436  # Embed endpoint → ollama-embed
OLLAMA_PROXY_RERANK_PORT=11437 # Rerank endpoint → ollama-rerank
# Port 8080 is always fixed for health/status — not configurable here.

# -----------------------------------------------------------------------------
# GPU SETTINGS (only used when COMPOSE_PROFILES=gpu)
# OLLAMA_NUM_GPU is set automatically per profile in docker-compose.yml.
# Override here only if you need to limit GPU count on a multi-GPU machine.
# -----------------------------------------------------------------------------
# OLLAMA_NUM_GPU=all

# -----------------------------------------------------------------------------
# OPEN WEBUI
# -----------------------------------------------------------------------------
OPEN_WEBUI_PORT=3030

# Generate a secure key: openssl rand -base64 32
WEBUI_SECRET_KEY=change-me-to-a-random-string

WEBUI_NAME=Sheria Legal Research
