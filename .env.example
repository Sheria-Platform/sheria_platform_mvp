# .env.example
# Copy this to .env and fill in the values

# --- APP SETTINGS ---
ENV=dev
LOG_LEVEL=INFO
JWT_SECRET_KEY=change_this_to_a_secure_random_string_for_jwt

# --- POSTGRES DATABASE ---
# Used by: services/api (case metadata, judicial decisions history)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ragadmin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=rag_db
DATABASE_URL=postgresql+asyncpg://ragadmin:changeme@localhost:5432/rag_db

# --- REDIS (Cache & Semantic Cache) ---
# Used by: services/api (semantic cache for legal research queries)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# --- QDRANT (Vector Database) ---
# Used by: services/api (semantic search across Kenya Law Reports)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=kenya_law_reports
QDRANT_IMAGE=qdrant/qdrant:v1.7.3

# --- NEO4J (Graph Database) ---
# Used by: services/api (citation graph, legal principle relationships)
NEO4J_HOST=localhost
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_AUTH=neo4j/password
NEO4J_URI=bolt://localhost:7687
NEO4J_MEMORY_PAGECACHE_SIZE=1G
NEO4J_IMAGE=neo4j:5.16.0-community

# --- MINIO (S3-Compatible Object Storage) ---
# Used by: pipelines/ingestion (store court documents, Kenya Law Reports)
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001
MINIO_SERVER_URL=http://localhost:9000
# MinIO buckets
MINIO_BUCKET_COURT_RECORDS=court-records-dev
MINIO_BUCKET_KENYA_LAW=kenya-law-reports-dev
MINIO_BUCKET_CASE_FILES=case-files-dev

# --- OLLAMA (Local LLM for Development) ---
# Used by: pipelines/ingestion (embeddings and graph extraction)
OLLAMA_HOST=http://localhost:11434
OLLAMA_PORT=11434
# Embedding model for vector generation
OLLAMA_EMBED_MODEL=nomic-embed-text
# LLM model for graph extraction
OLLAMA_LLM_MODEL=llama3
# GPU configuration (0 = CPU only, 1 = use GPU)
OLLAMA_NUM_GPU=1

# --- OPEN WEBUI (Ollama Web Interface) ---
# Used by: developers (test legal research queries, prototype judge interface)
OPEN_WEBUI_PORT=3000
WEBUI_SECRET_KEY=change_me_to_random_string_generate_with_openssl_rand_base64_32
ENABLE_SIGNUP=true
DEFAULT_USER_ROLE=user
ENABLE_RAG=true
RAG_EMBEDDING_ENGINE=ollama
RAG_EMBEDDING_MODEL=nomic-embed-text
ENABLE_WEB_SEARCH=false
WEBUI_NAME=Sheria Legal Research
WEBUI_AUTH=true

# --- AWS (Production Infrastructure) ---
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3 buckets for production
S3_BUCKET_COURT_RECORDS=sheria-court-records-prod
S3_BUCKET_KENYA_LAW=kenya-law-reports-prod
S3_BUCKET_CASE_FILES=case-files-prod

# --- RAY CLUSTER (AI Engines - Production) ---
# In K8s, these point to internal Service DNS
# Locally, you might port-forward
RAY_HEAD_HOST=localhost
RAY_DASHBOARD_PORT=8265
RAY_LLM_ENDPOINT=http://localhost:8000/llm
RAY_EMBED_ENDPOINT=http://localhost:8000/embed

# --- INGESTION PIPELINE SETTINGS ---
# Chunking configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=50
# Batch sizes
EMBEDDING_BATCH_SIZE=100
GRAPH_EXTRACTION_BATCH_SIZE=5
# Concurrency (number of parallel workers)
EMBEDDING_CONCURRENCY=5
GRAPH_EXTRACTION_CONCURRENCY=10

# --- EXTERNAL API INTEGRATIONS (Judiciary) ---
# Law Society of Kenya API (advocate verification)
LSK_API_KEY=
LSK_API_URL=https://api.lsk.or.ke/v1
# Ministry of Lands (title deed verification)
LANDS_REGISTRY_API_KEY=
LANDS_REGISTRY_API_URL=https://api.lands.go.ke/v1
# Civil Registration Services (birth/death certificates)
CIVIL_REGISTRATION_API_KEY=
CIVIL_REGISTRATION_API_URL=https://api.crs.go.ke/v1
# Judiciary Case Management System
JUDICIARY_CMS_API_KEY=
JUDICIARY_CMS_API_URL=https://api.judiciary.go.ke/v1

# --- OBSERVABILITY & MONITORING ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Logging
LOG_FORMAT=json
LOG_FILE_PATH=./logs/sheria.log
# Metrics
ENABLE_METRICS=true
METRICS_PORT=9090
# Tracing
ENABLE_TRACING=true
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# --- SECURITY & AUTHENTICATION ---
# JWT configuration
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
# CORS settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true
# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# --- FEATURE FLAGS ---
# Enable/disable features
ENABLE_DOCUMENT_VERIFICATION=true
ENABLE_GRAPH_EXTRACTION=true
ENABLE_SEMANTIC_CACHE=true
ENABLE_WORKLOAD_ANALYTICS=false  # Coming soon
